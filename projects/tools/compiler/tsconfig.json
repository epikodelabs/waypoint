{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "../../../dist/tools/compiler",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "tsBuildInfoFile": "../../../dist/tools/compiler/tsconfig.tsbuildinfo",
    "strict": true,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/tests/**/*.ts",
    "src/**/*.spec.ts",
    "src/**/*.patch.ts",
    "src/lib/emitters/group-artifacts-by-authorization.ts",
    "src/lib/semantic/implicit-root-slots.ts",
    "src/lib/validation/validate-artifact-authorization.ts",
    "src/lib/validation/validate-authorization-monotonicity.ts",
    "src/lib/validation/validate-implicit-root-slots.ts"
  ]
}
