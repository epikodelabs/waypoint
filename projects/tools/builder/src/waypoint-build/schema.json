{
  "$schema": "http://json-schema.org/schema",
  "title": "Waypoint build options",
  "type": "object",
  "properties": {
    "buildTarget": {
      "type": "string",
      "description": "Underlying Angular application build target."
    },
    "entry": {
      "type": "string",
      "default": "src/app/app.routes.ts",
      "description": "Waypoint navigation entry relative to the Angular project root."
    },
    "routesExport": {
      "type": "string",
      "default": "routes"
    },
    "profile": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "buildTarget"
  ],
  "additionalProperties": false
}
