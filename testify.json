{
  "srcDirs": [
    "projects/libraries/waypoint/src/lib",
    "templates/server-node-ts/src/waypoint-server"
  ],
  "testDirs": [
    "projects/libraries/waypoint/src/tests",
    "templates/server-node-ts/src/waypoint-server"
  ],
  "exclude": [
    "**/node_modules/**"
  ],
  "preserveOutputs": false,
  "outDir": "dist/.vite-jasmine-build",
  "browser": "chrome",
  "headless": false,
  "coverage": false,
  "port": 8889,
  "viteBuildOptions": {
    "target": "es2022",
    "sourcemap": "inline",
    "minify": false,
    "preserveModules": false,
    "preserveModulesRoot": "."
  },
  "jasmineConfig": {
    "env": {
      "stopSpecOnExpectationFailure": false,
      "random": true,
      "seed": 0,
      "timeout": 120000
    }
  },
  "htmlOptions": {
    "title": "Jasmine Test Runner",
    "preludeModules": [
      "@angular/compiler"
    ]
  },
  "suppressConsoleLogs": false
}
