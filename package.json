{
  "name": "waypoint",
  "version": "1.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng build --watch --configuration development",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "compiler:build": "tsc -p projects/tools/compiler/tsconfig.json",
    "compiler:check": "tsc -p projects/tools/compiler/tsconfig.json --noEmit",
    "compiler:compile": "npm run compiler:build && node scripts/compile-routes.mjs",
    "compiler:compile:clean": "node scripts/clean-routes.mjs && npm run compiler:compile",
    "compiler:compile:check": "npm run compiler:build && node scripts/compile-routes.mjs --dry-run",
    "compiler:watch": "npm run compiler:build && node scripts/watch-routes.mjs",
    "test": "testify --headless --browser chrome",
    "test:watch": "testify",
    "test:node": "testify --browser node",
    "test:coverage": "testify --headless --browser chrome --coverage"
  },
  "private": true,
  "type": "module",  
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "22.1.0",
    "@angular/compiler": "22.1.0",
    "@angular/core": "22.1.0",
    "@angular/forms": "22.1.0",
    "@angular/platform-browser": "22.1.0",
    "@angular/platform-server": "22.1.0",
    "@angular/router": "22.1.0",
    "@angular/ssr": "22.1.2",
    "express": "5.1.0",
    "rxjs": "7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.2",
    "@angular/cli": "22.1.2",
    "@angular/compiler-cli": "22.1.0",
    "@epikodelabs/testify": "^1.0.36",
    "@types/express": "5.0.3",
    "@types/jasmine": "^6.0.0",
    "@types/node": "24.3.0",
    "ng-packagr": "22.1.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
